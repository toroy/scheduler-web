<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false" scan="true">
    <springProperty scope="context" name="logMaxhistory" source="log.maxhistory"/>
    <springProperty scope="context" name="appName" source="spring.application.name"/>
    <logger name="org.springframework" level="INFO"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!--格式化输出：%d表示日期，%thread表示线程名，%-5level：级别从左显示5个字符宽度%msg：日志消息，%n是换行符-->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} |%-5level| %msg%n</pattern>
        </encoder>
    </appender>

    <!--web层、service层、dao层、error级别日志配置 -->
    <appender name="mainAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/scheduler-web.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/scheduler-web.log.%d{yyyy-MM-dd}</fileNamePattern>
            <MaxHistory>7</MaxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%-5level|%logger{56}.%method:%L|%msg%n
            </pattern>
        </encoder>
    </appender>
    <appender name="errorAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error/scheduler-web-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error/scheduler-web-error.log.%d{yyyy-MM-dd}</fileNamePattern>
            <MaxHistory>7</MaxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%-5level|%logger{56}.%method:%L|%msg%n
            </pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>
    
           <!-- 打印sql占位符-->
     <logger name="jdbc.connection" additivity="false" level="ERROR">
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="jdbc.resultset" additivity="false" level="ERROR">
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="jdbc.audit" additivity="false" level="ERROR">
         <appender-ref ref="STDOUT" /> 
    </logger>
    <logger name="jdbc.sqlonly" additivity="false" level="DEBUG">
         <appender-ref ref="STDOUT" /> 
    </logger>
    <logger name="jdbc.sqltiming" additivity="false" level="ERROR">
        <appender-ref ref="STDOUT" />
    </logger> 
    
    <!-- 系统日志 -->
    <root level="${logLevel}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="mainAppender"/>
        <appender-ref ref="errorAppender"/>
    </root>
</configuration>